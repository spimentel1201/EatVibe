# ============================================
# Database Configuration (PostgreSQL + PostGIS)
# ============================================
DB_URL=jdbc:postgresql://localhost:5432/courier_db
DB_USERNAME=foodrush
DB_PASSWORD=foodrush_dev_2026

# ============================================
# Kafka Configuration
# ============================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=courier-service-group

# ============================================
# Geolocation Configuration
# ============================================
# Radio máximo para asignación de repartidores (en kilómetros)
MAX_ASSIGNMENT_RADIUS_KM=10

# Radio de geofencing para validaciones (en metros)
# El courier debe estar dentro de este radio para marcar acciones
GEOFENCE_RADIUS_METERS=100

# Throttle para actualizaciones de ubicación (en segundos)
# Evita spam de updates, máximo 1 update cada X segundos
LOCATION_UPDATE_THROTTLE=5

# ============================================
# WebSocket Configuration
# ============================================
# Orígenes permitidos para conexiones WebSocket
# En producción, especifica los dominios exactos
WEBSOCKET_ALLOWED_ORIGINS=*

# Intervalo de heartbeat para detectar desconexiones (en milisegundos)
WEBSOCKET_HEARTBEAT_INTERVAL=10000

# ============================================
# Kafka Topics
# ============================================
KAFKA_TOPIC_COURIER_EVENTS=courier-events
KAFKA_TOPIC_DELIVERY_EVENTS=delivery-events
KAFKA_TOPIC_LOCATION_UPDATES=location-updates
KAFKA_TOPIC_ORDER_EVENTS=order-events

# ============================================
# Application Configuration
# ============================================
# Server port
SERVER_PORT=8086

# Spring Profile (dev, prod, test)
SPRING_PROFILES_ACTIVE=dev

# Log level
LOG_LEVEL=DEBUG