# ============================================
# Database Configuration
# ============================================
# PostgreSQL connection settings
DB_URL=jdbc:postgresql://localhost:5432/payments_db
DB_USERNAME=foodrush
DB_PASSWORD=foodrush_dev_2026

# ============================================
# Kafka Configuration
# ============================================
# Kafka broker connection
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=payment-service-group

# ============================================
# Stripe Payment Gateway
# ============================================
STRIPE_API_KEY=sk_test_51234567890abcdefghijklmnopqrstuvwxyz
STRIPE_WEBHOOK_SECRET=whsec_1234567890abcdefghijklmnopqrstuvwxyz

# ============================================
# Yape Payment Gateway
# ============================================
YAPE_ENABLED=true
YAPE_SIMULATION_MODE=true

# ============================================
# Application Configuration
# ============================================
# Server port
SERVER_PORT=8085

# Spring Profile (dev, prod, test)
SPRING_PROFILES_ACTIVE=dev

# Log level
LOG_LEVEL=DEBUG

# ============================================
# Kafka Topics
# ============================================
KAFKA_TOPIC_PAYMENT_EVENTS=payment-events
KAFKA_TOPIC_ORDER_EVENTS=order-events
KAFKA_TOPIC_REFUND_EVENTS=refund-events