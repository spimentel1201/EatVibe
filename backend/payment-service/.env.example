# ============================================
# Payment Service - Environment Variables
# ============================================
# 
# INSTRUCCIONES:
# 1. Copia este archivo como .env en la raíz del proyecto backend/payment-service/
# 2. Reemplaza los valores de ejemplo con tus credenciales reales
# 3. NUNCA commitees el archivo .env (está en .gitignore)
#

# ============================================
# Database Configuration
# ============================================
# PostgreSQL connection settings
DB_URL=jdbc:postgresql://localhost:5432/payments_db
DB_USERNAME=foodrush
DB_PASSWORD=foodrush_dev_2026

# ============================================
# Kafka Configuration
# ============================================
# Kafka broker connection
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=payment-service-group

# ============================================
# Stripe Payment Gateway
# ============================================
# Obtén tus credenciales en: https://dashboard.stripe.com/apikeys
# Para desarrollo, usa las claves de TEST (comienzan con sk_test_)
STRIPE_API_KEY=sk_test_51234567890abcdefghijklmnopqrstuvwxyz
STRIPE_WEBHOOK_SECRET=whsec_1234567890abcdefghijklmnopqrstuvwxyz

# ============================================
# Yape Payment Gateway
# ============================================
# Yape funciona en modo simulación por defecto
YAPE_ENABLED=true
YAPE_SIMULATION_MODE=true

# ============================================
# Application Configuration
# ============================================
# Server port
SERVER_PORT=8085

# Spring Profile (dev, prod, test)
SPRING_PROFILES_ACTIVE=dev

# Log level
LOG_LEVEL=DEBUG

# ============================================
# Kafka Topics
# ============================================
KAFKA_TOPIC_PAYMENT_EVENTS=payment-events
KAFKA_TOPIC_ORDER_EVENTS=order-events
KAFKA_TOPIC_REFUND_EVENTS=refund-events

# ============================================
# NOTAS IMPORTANTES
# ============================================
# 
# STRIPE:
# - Para desarrollo: usa claves TEST (sk_test_...)
# - Para producción: usa claves LIVE (sk_live_...)
# - Webhook secret: necesario para verificar eventos de Stripe
# 
# YAPE:
# - En modo simulación no requiere credenciales reales
# - Para producción, contactar con Yape para credenciales
# 
# SEGURIDAD:
# - NUNCA expongas estas credenciales en código
# - NUNCA commitees el archivo .env
# - Usa diferentes credenciales para dev/staging/prod
# - Rota las claves periódicamente
#
